# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rfp_management
DB_USER=write_yr
DB_PASSWORD=write_yr

# OpenAI Configuration
OPENAI_API_KEY=write yr key
OPENAI_MODEL=gpt-4-turbo-preview

# Email Configuration (Nodemailer with Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=write_yr@gmail.com
EMAIL_PASSWORD=write_yr
EMAIL_FROM=write_yr@gmail.com

# Alternative: SendGrid Configuration
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# IMAP Configuration for receiving emails
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=write_yr@gmail.com
IMAP_PASSWORD=write_yr

# Application Settings
FRONTEND_URL=http://localhost:3000
RFP_EMAIL_SUBJECT_PREFIX=[RFP]

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100